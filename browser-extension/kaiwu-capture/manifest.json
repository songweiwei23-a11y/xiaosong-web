{
  "manifest_version": 3,
  "name": "开物 · 截屏带入",
  "version": "0.5.0",
  "description": "在开物里粘贴抖音主页链接：自动读作品、点赞和热门作品的评论，带进开物拆解对标账号，或者诊断自己的号。也可以只截当前屏幕。",
  "permissions": ["activeTab", "storage", "unlimitedStorage"],
  "host_permissions": ["https://www.douyin.com/*", "https://*.douyinpic.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "开物 · 拆对标账号",
    "default_popup": "popup.html"
  },
  "commands": {
    "capture-screen": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "截下当前屏幕，带进开物"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.biandao.icu/*", "https://biandao.icu/*", "http://localhost:3000/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
