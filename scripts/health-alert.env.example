# 健康探测的通知配置。复制为服务器上的 /home/ubuntu/health-alert.env（权限设为 600），再填入群机器人的 webhook 地址。
# 不填 HEALTH_ALERT_WEBHOOK 时不发送通知，只写 health-alert.log。
#
# HEALTH_ALERT_KIND 可选：
#   wecom     企业微信群机器人（默认）
#   dingtalk  钉钉群机器人（格式同企业微信，填 wecom 或 dingtalk 都行）
#   feishu    飞书群机器人
HEALTH_ALERT_WEBHOOK=
HEALTH_ALERT_KIND=wecom
