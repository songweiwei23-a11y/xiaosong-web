# 强制所有文本文件使用LF行尾
* text=auto eol=lf

# TypeScript/JavaScript文件强制UTF-8编码
*.ts text eol=lf encoding=utf-8
*.tsx text eol=lf encoding=utf-8
*.js text eol=lf encoding=utf-8
*.jsx text eol=lf encoding=utf-8
*.json text eol=lf encoding=utf-8

# Markdown和配置文件
*.md text eol=lf encoding=utf-8
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
